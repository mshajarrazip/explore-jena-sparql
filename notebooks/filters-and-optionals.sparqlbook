    "value": "# [endpoint=http://localhost:3030/ds/sparql]\nPREFIX vcard: <http://www.w3.org/2001/vcard-rdf/3.0#>\n\nSELECT ?y ?firstName\nWHERE {\n  ?y vcard:Family \"Smith\" .\n  ?y vcard:Given ?firstName .\n}",
