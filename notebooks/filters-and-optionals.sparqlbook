    "value": "# [endpoint=http://localhost:3030/ds/sparql]\n\nPREFIX info: <http://somewhere/peopleInfo#>\n\nSELECT ?resource\nWHERE {\n  ?resource info:age ?age .\n  FILTER (?age >= 24)\n}",
    "metadata": {}
